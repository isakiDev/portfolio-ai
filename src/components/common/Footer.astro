---
import Icon from "../ui/Icon.astro";
---

<footer class="w-full py-6 border-t border-border bg-background">
  <div
    class="flex flex-col md:flex-row justify-between items-center px-4 sm:px-8 md:px-16 max-w-5xl mx-auto gap-6 md:gap-8"
  >
    <div class="text-base text-foreground">Gaspar.</div>
    <div class="flex flex-wrap justify-center gap-x-3 gap-y-3 font-mono text-xs tracking-wider leading-none font-medium">
      <a
        class="text-muted-foreground hover:text-primary transition-colors opacity-80 hover:opacity-100 flex items-center gap-1"
        href="#"
      >
        <Icon name="code" size="text-[14px]" /> GitHub
      </a>
      <a
        class="text-muted-foreground hover:text-primary transition-colors opacity-80 hover:opacity-100 flex items-center gap-1"
        href="#"
      >
        <Icon name="person" size="text-[14px]" /> LinkedIn
      </a>
      <a
        class="text-muted-foreground hover:text-primary transition-colors opacity-80 hover:opacity-100 flex items-center gap-1"
        href="#"
      >
        <Icon name="terminal" size="text-[14px]" /> DevTalles
      </a>
      <span class="mx-2 opacity-20 hidden sm:inline">|</span>
      <a
        class="text-muted-foreground hover:text-foreground transition-colors opacity-80 hover:opacity-100"
        href="#"
        >Código</a
      >
      <a
        class="text-muted-foreground hover:text-foreground transition-colors opacity-80 hover:opacity-100"
        href="#"
        >Contacto</a
      >
      <a
        class="text-muted-foreground hover:text-foreground transition-colors opacity-80 hover:opacity-100"
        href="#"
        >RSS</a
      >
    </div>
    <div class="font-mono text-xs tracking-wider leading-none font-medium text-muted-foreground">
      &copy; 2024 SYSTEM_CORE_V2
    </div>
  </div>
</footer>
