---
export interface Props {
  song: string;
  artist: string;
}

const { song, artist } = Astro.props;
---

<div
  class="flex items-center gap-2 mr-4 py-1 px-2 bg-muted rounded-full border border-border/30"
>
  <span class="material-symbols-outlined text-[14px] text-primary animate-pulse"
    >graphic_eq</span
  >
  <span class="font-mono text-[10px] text-muted-foreground truncate max-w-[150px]"
    >{song} — {artist}</span
  >
</div>
