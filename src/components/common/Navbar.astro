---
import ChevronRight from "@components/icons/ChevronRight.astro";
import MusicWidget from "@components/common/MusicWidget.astro";

const navLinks = [
  { href: "#about", label: "Sobre mí" },
  { href: "#experience", label: "Trayectoria" },
  { href: "#projects", label: "Laboratorio" },
  { href: "#blog", label: "Notas" },
];
---

<header
  class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-border"
>
  <nav
    class="flex justify-between items-center px-4 sm:px-8 md:px-16 h-16 max-w-5xl mx-auto"
    aria-label="Navegación principal"
  >
    <a
      href="/"
      aria-label="Ir al inicio"
      class="font-mono text-sm font-bold text-primary transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
    >
      ROOT_DIR
    </a>

    <div class="hidden md:flex gap-3 items-center">
      <MusicWidget song="Highway to Hell" artist="AC/DC" />

      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-muted-foreground hover:text-foreground transition-colors text-sm rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {link.label}
        </a>
      ))}

      <button
        aria-label="Alternar tema"
        data-theme-toggle
        class="shrink-0 size-8 flex items-center justify-center rounded-md text-muted-foreground bg-card border border-border transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg
          class="size-4 hidden dark:block"
          data-icon-sun
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
          class="size-4 dark:hidden"
          data-icon-moon
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
        </svg>
      </button>

      <button
        aria-label="Abrir paleta de comandos"
        class="flex items-center gap-2 px-3 py-1.5 rounded-md bg-card border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <ChevronRight />
        <span class="font-mono text-[10px]">CMD + K</span>
      </button>
    </div>

    <div class="flex md:hidden items-center gap-2">
      <button
        aria-label="Alternar tema"
        data-theme-toggle
        class="shrink-0 size-8 flex items-center justify-center rounded-md text-muted-foreground bg-card border border-border transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg
          class="size-4 hidden dark:block"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
          class="size-4 dark:hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
        </svg>
      </button>

      <button
        aria-label="Abrir menú de navegación"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
        class="shrink-0 size-8 flex items-center justify-center rounded-md text-muted-foreground bg-card border border-border transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg
          class="size-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="md:hidden hidden px-4 sm:px-8 pb-6 pt-2 bg-background/95 backdrop-blur-xl border-b border-border"
    data-mobile-menu
  >
    <div class="flex flex-col gap-1 font-mono text-sm">
      <MusicWidget song="Highway to Hell" artist="AC/DC" />
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-menu-close
          class="text-muted-foreground hover:text-foreground transition-colors py-2.5 border-b border-border/40 focus-visible:outline-none focus-visible:text-foreground"
        >
          {link.label}
        </a>
      ))}
      <button
        aria-label="Abrir paleta de comandos"
        class="flex items-center gap-2 px-3 py-2.5 mt-2 w-fit rounded-md bg-card border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <ChevronRight />
        <span class="font-mono text-[10px]">CMD + K</span>
      </button>
    </div>
  </div>
</header>

<script data-astro-rerun>
  const toggleButtons = document.querySelectorAll("[data-theme-toggle]");
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  const closeLinks = document.querySelectorAll("[data-menu-close]");
  const root = document.documentElement;
  const storageKey = "portfolio-theme";

  toggleButtons.forEach((button) => {
    button.addEventListener("click", () => {
      root.classList.toggle("dark");
      const isDark = root.classList.contains("dark");

      try {
        localStorage.setItem(storageKey, isDark ? "dark" : "light");
      } catch (error) {
        /* storage not available; keep theme in session */
      }
    });
  });

  if (menuToggle && menu) {
    const updateExpanded = () => {
      const isOpen = !menu.classList.contains("hidden");
      menuToggle.setAttribute("aria-expanded", String(isOpen));
    };

    menuToggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
      updateExpanded();
    });

    closeLinks.forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        updateExpanded();
      });
    });
  }
</script>