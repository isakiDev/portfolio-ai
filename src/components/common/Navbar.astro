---
import Icon from "../ui/Icon.astro";
import MusicWidget from "./MusicWidget.astro";
---

<header
  class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-white/10"
>
  <nav
    class="flex justify-between items-center px-4 sm:px-8 md:px-16 h-16 max-w-container-max mx-auto"
  >
    <div
      aria-label="Gaspar Castillo Portfolio Home"
      class="font-mono text-sm font-bold text-primary"
    >
      ROOT_DIR
    </div>
    <div class="hidden md:flex gap-3 items-center">
      <MusicWidget song="Highway to Hell" artist="AC/DC" />
      <a
        class="text-secondary hover:text-on-surface transition-colors font-sans text-sm"
        href="#about"
        >Sobre mí</a
      >
      <a
        class="text-secondary hover:text-on-surface transition-colors font-sans text-sm"
        href="#experience"
        >Trayectoria</a
      >
      <a
        class="text-secondary hover:text-on-surface transition-colors font-sans text-sm"
        href="#projects"
        >Laboratorio</a
      >
      <a
        class="text-secondary hover:text-on-surface transition-colors font-sans text-sm"
        href="#blog"
        >Notas</a
      >
      <button
        aria-label="Abrir paleta de comandos"
        class="flex items-center gap-2 px-3 py-1.5 bg-surface-container border border-white/10 rounded hover:bg-surface-container-high transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >
        <Icon name="search" size="text-[18px]" class="text-secondary" />
        <span class="font-mono text-[10px] text-secondary">CMD + K</span>
      </button>
    </div>
    <button
      aria-label="Abrir menú de navegación"
      class="md:hidden flex items-center gap-2 px-3 py-1.5 bg-surface-container border border-white/10 rounded hover:bg-surface-container-high transition-all"
      data-menu-toggle
    >
      <Icon name="menu" size="text-[18px]" class="text-secondary" />
    </button>
  </nav>
  <div
    class="md:hidden hidden px-4 sm:px-8 pb-6 pt-2 bg-surface/95 backdrop-blur-xl border-b border-white/10"
    data-mobile-menu
  >
    <div class="flex flex-col gap-4 font-mono text-sm">
      <MusicWidget song="Highway to Hell" artist="AC/DC" />
      <a
        class="text-secondary hover:text-on-surface transition-colors py-2 border-b border-white/5"
        href="#about"
        data-menu-close
        >Sobre mí</a
      >
      <a
        class="text-secondary hover:text-on-surface transition-colors py-2 border-b border-white/5"
        href="#experience"
        data-menu-close
        >Trayectoria</a
      >
      <a
        class="text-secondary hover:text-on-surface transition-colors py-2 border-b border-white/5"
        href="#projects"
        data-menu-close
        >Laboratorio</a
      >
      <a
        class="text-secondary hover:text-on-surface transition-colors py-2 border-b border-white/5"
        href="#blog"
        data-menu-close
        >Notas</a
      >
      <button
        aria-label="Abrir paleta de comandos"
        class="flex items-center gap-2 px-3 py-2 bg-surface-container border border-white/10 rounded hover:bg-surface-container-high transition-all w-fit"
      >
        <Icon name="search" size="text-[18px]" class="text-secondary" />
        <span class="font-mono text-[10px] text-secondary">CMD + K</span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  const closeLinks = document.querySelectorAll("[data-menu-close]");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });

    closeLinks.forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
      });
    });
  }
</script>
