---
import { featuredPost, recentPosts } from "@data/blog-posts";
import SectionHeading from "@components/ui/SectionHeading.astro";
---

<section
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
  id="blog"
>
  <SectionHeading label="blog.md" />
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-7">
      <div class="group cursor-pointer">
        <div
          class="aspect-video bg-card rounded-lg overflow-hidden mb-4 sm:mb-6 relative border border-border/30"
        >
          <div
            class="absolute inset-0 bg-gradient-to-t from-background to-transparent opacity-60"
          >
          </div>
          <div
            class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6"
          >
            <span
              class="px-2 py-1 bg-primary text-primary-foreground font-mono text-[10px] rounded uppercase mb-2 sm:mb-3 inline-block"
            >
              {featuredPost.category}
            </span>
            <h4
              class="text-2xl lg:text-4xl lg:leading-[1.2] lg:tracking-[-0.02em] lg:font-medium text-foreground group-hover:text-primary transition-colors"
            >
              {featuredPost.title}
            </h4>
          </div>
        </div>
        <p
          class="text-muted-foreground text-sm sm:text-base mb-3 sm:mb-4 line-clamp-2"
        >
          {featuredPost.description}
        </p>
        <div
          class="flex items-center gap-3 sm:gap-4 font-mono text-xs tracking-wider leading-none font-medium text-muted-foreground/60"
        >
          <span>{featuredPost.readTime}</span>
          <span>•</span>
          <span>{featuredPost.date}</span>
        </div>
      </div>
    </div>
    <div class="lg:col-span-5 space-y-6 lg:space-y-8">
      {
        recentPosts.map((post, i) => {
          const borderClass =
            i > 0 ? "border-t border-border/30 pt-6 lg:pt-8" : "";
          return (
            <div
              class={`group cursor-pointer flex gap-3 sm:gap-4 ${borderClass}`}
            >
              <div class="flex-1 min-w-0">
                <span class="font-mono text-[10px] text-primary mb-1 block uppercase truncate">
                  {post.category}
                </span>
                <h4 class="text-xl group-hover:text-primary transition-colors mb-1 sm:mb-2">
                  {post.title}
                </h4>
                <div class="font-mono text-[10px] text-muted-foreground/60">
                  {post.readTime}
                </div>
              </div>
              <div class="w-16 h-16 sm:w-20 sm:h-20 bg-card rounded border border-border/30 flex-shrink-0" />
            </div>
          );
        })
      }
    </div>
  </div>
</section>
