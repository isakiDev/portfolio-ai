---
import SectionHeading from "@components/ui/SectionHeading.astro";
import { getLatestCommits } from "@/lib/github";

const { commits } = await getLatestCommits();
---

<section
  aria-live="polite"
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
  id="projects"
  role="log"
>
  <SectionHeading label="./var/log / git_activity" className="mb-6 sm:mb-8" />
  <div
    class="font-mono text-[11px] sm:text-[12px] border-l border-border pl-3 sm:pl-4"
  >
    {
      commits.map((commit) => (
        <div class="flex flex-col sm:flex-row sm:gap-4 py-1.5 sm:py-1 hover:bg-muted transition-colors group">
          <span class="text-muted-foreground/40 sm:w-auto">{commit.date}</span>

          <div>
            <span class="text-accent">[COMMIT]</span>
            <span class="text-foreground">{commit.message}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>
