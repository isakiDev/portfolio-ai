---
import SectionHeading from "@components/ui/SectionHeading.astro";
import GitHubIcon from "../icons/GitHub.astro";

import { getLatestCommits } from "@/lib/github";

const repositories = await getLatestCommits();

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  const months = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ];
  return `${months[d.getUTCMonth()]} ${String(d.getUTCDate()).padStart(2, "0")}`;
}

function shortHash(url: string): string {
  const parts = url.split("/");
  return parts[parts.length - 1]?.slice(0, 7) ?? "";
}
---

<section
  id="activity"
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
>
  <SectionHeading label="github.log" className="mb-8" />

  <div
    class="border-l border-border pl-4 font-mono text-[11px] sm:text-xs space-y-8"
  >
    {
      repositories.map(({ repo, commits }) => (
        <article class="space-y-3">
          <a
            href={`https://github.com/isakidev/${repo}`}
            target="_blank"
            class="inline-flex items-center gap-2 text-muted-foreground/70 hover:text-accent transition-colors"
          >
            <GitHubIcon />

            <span class="font-semibold text-accent">{repo}</span>
          </a>

          <ul class="space-y-1">
            {commits.map((commit) => (
              <li>
                <a
                  href={commit.url}
                  target="_blank"
                  class="flex flex-col sm:flex-row sm:items-center sm:gap-4 rounded px-2 py-1 transition-colors hover:bg-muted"
                >
                  <time
                    datetime={commit.date}
                    class="shrink-0 text-muted-foreground/40"
                  >
                    {formatDate(commit.date)}
                  </time>

                  <div class="flex gap-1.5 min-w-0">
                    <span class="shrink-0 text-accent">
                      [{shortHash(commit.url)}]
                    </span>

                    <span class="truncate text-foreground">
                      {commit.message}
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
