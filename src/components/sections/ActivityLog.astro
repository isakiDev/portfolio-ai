---
import SectionHeading from "@components/ui/SectionHeading.astro";
import { getLatestCommits } from "@/lib/github";

const repositories = await getLatestCommits();

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  const months = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ];
  return `${months[d.getUTCMonth()]} ${String(d.getUTCDate()).padStart(2, "0")}`;
}

function shortHash(url: string): string {
  const parts = url.split("/");
  return parts[parts.length - 1]?.slice(0, 7) ?? "";
}
---

<section
  aria-live="polite"
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
  id="activity"
  role="log"
>
  <SectionHeading label="./var/log / git_activity" className="mb-6 sm:mb-8" />

  <div
    class="font-mono text-[11px] sm:text-[12px] border-l border-border pl-3 sm:pl-4"
  >
    {
      repositories.map(({ repo, commits }) => (
        <>
          <a
            class="flex items-center gap-2 text-muted-foreground/60 hover:text-accent transition-colors mb-3 sm:mb-2"
            href={`https://github.com/isakidev/${repo}`}
            target="_blank"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            <span class="text-accent font-semibold">{repo}</span>
          </a>

          {commits.map((commit) => (
            <a
              class="flex flex-col sm:flex-row sm:gap-4 py-1.5 sm:py-1 hover:bg-muted transition-colors group"
              href={commit.url}
              target="_blank"
            >
              <span class="text-muted-foreground/40 shrink-0">
                {formatDate(commit.date)}
              </span>

              <div class="truncate flex gap-1.5">
                <span class="text-accent shrink-0">
                  [{shortHash(commit.url)}]
                </span>

                <span class="text-foreground">{commit.message}</span>
              </div>
            </a>
          ))}
        </>
      ))
    }
  </div>
</section>
