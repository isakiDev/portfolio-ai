---
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";

export interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  statusLabel: string;
  statusVariant: "primary" | "accent" | "secondary";
  tech: string[];
  url?: string;
  repoUrl?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  statusLabel,
  statusVariant,
  tech,
  url,
  repoUrl,
} = Astro.props;
---

<article
  class="group rounded-lg border border-border/30 bg-card/30 p-6 transition-all hover:border-primary/30 hover:bg-card sm:p-8"
>
  <figure
    class="mb-5 overflow-hidden rounded border border-border bg-card transition-colors group-hover:border-primary/30 sm:mb-6"
  >
    {
      url ? (
        <a href={url} target="_blank" rel="noopener noreferrer">
          <img
            src={image}
            alt={imageAlt}
            class="aspect-video h-full w-full object-cover opacity-80 transition-opacity duration-500 group-hover:opacity-100"
          />
        </a>
      ) : (
        <img
          src={image}
          alt={imageAlt}
          class="aspect-video h-full w-full object-cover opacity-80"
        />
      )
    }
  </figure>

  <header class="mb-5 flex items-start justify-between gap-4 sm:mb-6">
    <div class="min-w-0 flex-1">
      <h3 class="mb-2 text-foreground">{title}</h3>

      <div class="flex flex-wrap gap-2">
        <Badge variant={statusVariant}>{statusLabel}</Badge>

        {
          tech.map((technology) => (
            <Badge variant="secondary">{technology}</Badge>
          ))
        }
      </div>
    </div>

    {
      (repoUrl || url) && (
        <nav
          class="flex shrink-0 gap-2"
          aria-label={`Project links for ${title}`}
        >
          {repoUrl && (
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              title="View source code"
              aria-label="View source code"
              class="text-muted-foreground/40 transition-colors hover:text-primary"
            >
              <Icon name="code" size="text-[18px]" />
            </a>
          )}

          {url && (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              title="View live project"
              aria-label="View live project"
              class="text-muted-foreground/40 transition-colors hover:text-primary"
            >
              <Icon name="arrow_outward" size="text-[18px]" />
            </a>
          )}
        </nav>
      )
    }
  </header>

  <p class="text-sm leading-relaxed text-muted-foreground">
    {description}
  </p>
</article>
