---
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";

export interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  statusLabel: string;
  statusVariant: "primary" | "tertiary" | "secondary";
  techLabel: string;
}
---

<div
  class="p-6 sm:p-8 border border-border/30 rounded-lg bg-card/30 hover:bg-card hover:border-primary/30 transition-all group cursor-pointer"
>
  <div
    class="aspect-video mb-5 sm:mb-6 rounded overflow-hidden border border-border bg-card relative group-hover:border-primary/30 transition-colors"
  >
    <img
      alt={Astro.props.imageAlt}
      class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500"
      src={Astro.props.image}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-background/40 to-transparent"></div>
  </div>
  <div class="flex justify-between items-start mb-5 sm:mb-6">
    <div>
      <h4 class="text-foreground mb-2">{Astro.props.title}</h4>
      <div class="flex gap-2">
        <Badge variant={Astro.props.statusVariant}>
          {Astro.props.statusLabel}
        </Badge>
        <Badge variant="secondary">{Astro.props.techLabel}</Badge>
      </div>
    </div>
    <Icon
      name="arrow_outward"
      size="text-[18px]"
      class="text-muted-foreground/40 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300"
    />
  </div>
  <p class="text-muted-foreground text-sm leading-relaxed">
    {Astro.props.description}
  </p>
</div>
