---
export interface Props {
  song: string;
  artist: string;
}

const { song, artist } = Astro.props;
---

<div
  class="inline-flex items-center gap-2 rounded-full border border-border/50 bg-muted py-1 pl-2.5 pr-3"
>
  <svg
    class="size-3.5 text-primary"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <rect x="3" y="13" width="3" height="8" rx="1.5" />
    <rect x="10.5" y="8" width="3" height="13" rx="1.5" />
    <rect x="18" y="5" width="3" height="16" rx="1.5" />
  </svg>
  <span class="truncate font-mono text-[10px] text-muted-foreground max-w-[150px]"
    >{song} — {artist}</span
  >
</div>