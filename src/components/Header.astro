---
import ChevronRight from "@components/icons/ChevronRight.astro";
import ThemeToggleButton from "@components/ThemeToggleButton.astro";
import MusicWidget from "@components/MusicWidget.astro";

const navLinks = [
  { href: "#about", label: "Sobre mí" },
  { href: "#experience", label: "Experiencia" },
  { href: "#projects", label: "Proyectos" },
  { href: "#blog", label: "Blog" },
];
---

<header
  class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-border"
>
  <nav
    class="flex justify-between items-center px-4 sm:px-8 md:px-16 h-16 max-w-5xl mx-auto"
    aria-label="Navegación principal"
  >
    <a
      href="/"
      aria-label="Ir al inicio"
      class="font-mono text-sm font-bold text-primary transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
    >
      ROOT_DIR
    </a>

    <div class="hidden md:flex gap-3 items-center">
      <MusicWidget song="Highway to Hell" artist="AC/DC" />

      <ul class="flex items-center gap-3">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-muted-foreground hover:text-foreground transition-colors text-sm rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ThemeToggleButton />

      <button
        type="button"
        aria-label="Abrir paleta de comandos"
        class="flex items-center gap-2 px-3 py-1.5 rounded-md bg-card border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <ChevronRight />
        <span class="font-mono text-[10px]">CMD + K</span>
      </button>
    </div>

    <div class="flex md:hidden items-center gap-2">
      <button
        id="btn-menu"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="size-8 flex items-center justify-center rounded-md text-muted-foreground bg-card border border-border transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg
          class="size-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <nav
    id="mobile-menu"
    aria-label="Navegación móvil"
    class="md:hidden hidden px-4 sm:px-8 pb-6 pt-2 bg-background/95 backdrop-blur-xl border-b border-border"
    inert
  >
    <div class="flex flex-col gap-1 font-mono text-sm">
      <MusicWidget song="Highway to Hell" artist="AC/DC" />
      <ul class="flex flex-col">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block text-muted-foreground hover:text-foreground transition-colors py-2.5 border-b border-border/40 focus-visible:outline-none focus-visible:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        aria-label="Abrir paleta de comandos"
        class="flex items-center gap-2 px-3 py-2.5 mt-2 w-fit rounded-md bg-card border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <ChevronRight />
        <span class="font-mono text-[10px]">CMD + K</span>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  // const menu = document.getElementById("mobile-menu");
  // const isOpenMenu = !menu.classList.contains("hidden");
  // const toggleMenuButton = document.getElementById("mobile-menu");

  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  };

  const themeButtons = document.querySelectorAll("[data-theme-toggle]");

  themeButtons.forEach((button) =>
    button.addEventListener("click", handleToggleClick),
  );

  // if (menuToggle && menu) {
  //     const updateExpanded = () => {
  //       const isOpen = !menu.classList.contains("hidden");
  //       menuToggle.setAttribute("aria-expanded", String(isOpen));
  //     };

  //     menuToggle.addEventListener("click", () => {
  //       menu.classList.toggle("hidden");
  //       updateExpanded();
  //     });

  //     closeLinks.forEach((link) => {
  //       link.addEventListener("click", () => {
  //         menu.classList.add("hidden");
  //         updateExpanded();
  //       });
  //     });
  //   }
</script>
