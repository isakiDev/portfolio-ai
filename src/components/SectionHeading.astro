---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<h2
  class:list={[
    "font-mono text-base lg:text-lg tracking-wider leading-none font-semibold text-muted-foreground border-l-2 border-primary pl-3",
    className ?? "mb-10",
  ]}
>
  {label}
</h2>
