---
import Layout from "@layouts/Layout.astro";

import {
  Hero,
  About,
  ProjectGrid,
  Experience,
  ActivityLog,
} from "@features/portfolio";

import ActivityLogSkeleton from "@features/portfolio/components/ActivityLogSkeleton.astro";

import { Blog } from "@features/blog";
---

<Layout title="Portfolio de Gaspar Castillo | Desarrollador de Software">
  <Hero />
  <About />
  <ProjectGrid />
  <Experience />
  <ActivityLog server:defer>
    <ActivityLogSkeleton slot="fallback" />
  </ActivityLog>
  <Blog />
</Layout>
