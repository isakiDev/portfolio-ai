---
import ContentContainer from "@components/ContentContainer.astro";
import Layout from "@layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectListItem from "@/features/projects/components/ProjectListItem.astro";
import { getPublishedProjects } from "@/features/projects/utils/get-published-projects";
import { absoluteUrl, buildPageTitle } from "@/utils/seo";

const projects = await getPublishedProjects();
---

<Layout
  title={buildPageTitle("Proyectos")}
  url={absoluteUrl("/projects")}
>
  <ContentContainer>
    <main>
      <section>
        <SectionHeading label="Proyectos" />
        {projects.map((project) => (
          <ProjectListItem entry={project} showMeta={false} />
        ))}
      </section>
    </main>
  </ContentContainer>
</Layout>
