---
import { getCollection } from "astro:content";

import ContentContainer from "@components/ContentContainer.astro";
import Layout from "@layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectListItem from "@/features/projects/components/ProjectListItem.astro";

const data = await getCollection("projects", ({ data }) => !data.draft);
data.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title={`Proyectos | Gaspar Castillo - Desarrollador de Software`}
  url={`https://isakidev.vercel.app/blog`}
>
  <ContentContainer>
    <main>
      <section>
        <SectionHeading label="Proyectos" />
        {data.map((project) => (
          <ProjectListItem entry={project} showMeta={false} />
        ))}
      </section>
    </main>
  </ContentContainer>
</Layout>
