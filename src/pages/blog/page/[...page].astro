---
import { getCollection } from "astro:content";

import Layout from "@layouts/Layout.astro";
import ContentWrapper from "@features/blog/components/ContentWrapper.astro";

import {
  PostList,
  Pagination,
  Breadcrumb,
  paginate,
  BLOG_ITEMS_PER_PAGE,
} from "@features/blog";

export async function getStaticPaths() {
  const blog = await getCollection("blog", ({ data }) => !data.draft);

  const totalPages = Math.max(1, Math.ceil(blog.length / BLOG_ITEMS_PER_PAGE));

  return Array.from({ length: totalPages }, (_, index) => ({
    params: { page: String(index + 1) },
  }));
}

const pageNumber = Number(Astro.params.page);

const blog = await getCollection("blog", ({ data }) => !data.draft);
blog.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const { paginatedItems, currentPage, totalPages } = paginate({
  items: blog,
  currentPage: pageNumber,
  perPage: BLOG_ITEMS_PER_PAGE,
});

const breadcrumbs = [
  {
    name: "Inicio",
    href: "/",
  },
  {
    name: "Blog",
  },
];
---

<Layout
  title={`Blog - Página ${currentPage} | Gaspar Castillo - Desarrollador de Software`}
>
  <ContentWrapper>
    <Breadcrumb breadcrumbs={breadcrumbs} />

    <main>
      <PostList items={paginatedItems} />
      <Pagination currentPage={currentPage} totalPages={totalPages} />
    </main>
  </ContentWrapper>
</Layout>
