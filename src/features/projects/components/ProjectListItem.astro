---
import type { CollectionEntry } from "astro:content";
import { Book, ExternalLink, FolderGit } from "@lucide/astro";

import Badge from "@/components/Badge.astro";
import LinkButton from "@/components/ui/LinkButton.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  class?: string;
  showMeta?: boolean;
}

const { entry, class: classProp, showMeta = true } = Astro.props;

const {
  title,
  description,
  cover,
  coverAlt,
  technologies,
  repoURL,
  websiteURL,
  caseStudyURL,
} = entry.data;

const imageAlt = coverAlt ?? `${title} cover image`;
const caseStudyHref = caseStudyURL ? `/projects/${entry.id}/` : undefined;
---

<article
  class:list={[
    "group flex flex-col gap-5 py-6 sm:flex-row sm:items-start sm:gap-5 sm:py-5 border-b last:border-b-0 border-border",
    classProp,
  ]}
>
  {showMeta && cover && (
    caseStudyHref ? (
      <a
        href={caseStudyHref}
        class="block w-full shrink-0 overflow-hidden rounded-md border border-border bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:w-70"
        aria-label={`Leer sobre ${title}`}
      >
        <img
          src={cover}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </a>
    ) : (
      <div class="block w-full shrink-0 overflow-hidden rounded-md border border-border bg-background sm:w-70">
        <img
          src={cover}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="aspect-video w-full object-cover"
        />
      </div>
    )
  )}

  <div class="min-w-0 flex-1 p-4 md:p-0">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-sm font-semibold tracking-tight text-foreground sm:text-base">
        {caseStudyHref ? (
          <a
            href={caseStudyHref}
            class="transition-colors duration-200 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {title}
          </a>
        ) : (
          <span>{title}</span>
        )}
      </h3>
    </div>

    {description && (
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2 sm:mt-1.5">
        {description}
      </p>
    )}

    {showMeta && technologies && technologies.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5 sm:mt-3">
        {technologies.map((tag) => (
          <Badge variant="accent">{tag}</Badge>
        ))}
      </div>
    )}

    {showMeta && (caseStudyHref || websiteURL || repoURL) && (
      <nav
        class="mt-5 flex flex-wrap items-center gap-2.5 sm:mt-4 sm:gap-2"
        aria-label={`Acciones para ${title}`}
      >
        {caseStudyHref && (
          <LinkButton href={caseStudyHref} variant="outline" size="sm">
            <Book size={14} />
            Cómo lo hice
          </LinkButton>
        )}

        {websiteURL && (
          <LinkButton href={websiteURL} variant="outline" size="sm" external>
            <ExternalLink size={14} />
            Ver deploy
          </LinkButton>
        )}

        {repoURL && (
          <LinkButton href={repoURL} variant="outline" size="sm" external>
            <FolderGit size={14} />
            Ver código
          </LinkButton>
        )}
      </nav>
    )}
  </div>
</article>
