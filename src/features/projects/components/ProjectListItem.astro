---
import type { CollectionEntry } from "astro:content";

import { ArrowRight, Book, ExternalLink, FolderGit } from "@lucide/astro";

import Badge from "@/components/Badge.astro";
import LinkButton from "@/components/ui/LinkButton.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  class?: string;
  showMeta?: boolean;
}

const { entry, class: className, showMeta = true } = Astro.props;

const {
  title,
  description,
  cover,
  coverAlt,
  technologies,
  repoURL,
  websiteURL,
  caseStudyURL,
} = entry.data;

const imageAlt = coverAlt ?? `${title} cover image`;
const caseStudyHref = caseStudyURL ? `/projects/${entry.id}/` : undefined;
---

<article
  class:list={[
    "relative flex flex-col border-b border-border last:border-b-0",
    showMeta
      ? "group"
      : [
          "group border-l-2 border-l-transparent",
          "transition-[padding-left,border-color,background-color] duration-200 ease-in-out",
          "hover:border-l-primary hover:bg-muted/30 hover:pl-2",
        ],
    className,
  ]}
>
  {showMeta &&
    cover &&
    (caseStudyHref ? (
      <a
        href={caseStudyHref}
        class="group/cover block w-full shrink-0 overflow-hidden rounded-md border border-border bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:w-70"
        aria-label={`Leer sobre ${title}`}
      >
        <img
          src={cover}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="aspect-video w-full object-cover transition-transform duration-300 group-hover/cover:scale-[1.03]"
        />
      </a>
    ) : (
      <div class="block w-full shrink-0 overflow-hidden rounded-md border border-border bg-background sm:w-70">
        <img
          src={cover}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="aspect-video w-full object-cover"
        />
      </div>
    ))}

  {showMeta ? (
    <div class="min-w-0 flex-1 p-4 md:p-0">
      <h3 class="text-sm font-semibold tracking-tight text-foreground sm:text-base">
        {title}
      </h3>

      {description && (
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground line-clamp-2">
          {description}
        </p>
      )}

      {technologies && technologies.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {technologies.map((tag) => (
            <Badge variant="accent">{tag}</Badge>
          ))}
        </div>
      )}

      {(caseStudyHref || websiteURL || repoURL) && (
        <nav
          class="mt-4 flex flex-wrap items-center gap-2"
          aria-label={`Acciones para ${title}`}
        >
          {caseStudyHref && (
            <LinkButton href={caseStudyHref} variant="outline" size="sm">
              <Book size={14} />
              Cómo lo hice
            </LinkButton>
          )}

          {websiteURL && (
            <LinkButton href={websiteURL} variant="outline" size="sm" external>
              <ExternalLink size={14} />
              Ver deploy
            </LinkButton>
          )}

          {repoURL && (
            <LinkButton href={repoURL} variant="outline" size="sm" external>
              <FolderGit size={14} />
              Ver código
            </LinkButton>
          )}
        </nav>
      )}
    </div>
  ) : caseStudyHref ? (
    <a
      href={caseStudyHref}
      class="group/link relative block min-w-0 flex-1 pr-8 pl-0 no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      aria-label={`Leer sobre ${title}`}
    >
      <span class="text-sm font-semibold tracking-tight text-foreground transition-colors duration-200 group-hover/link:text-primary sm:text-base">
        {title}
      </span>

      {description && (
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground line-clamp-2">
          {description}
        </p>
      )}

      <ArrowRight
        size={18}
        aria-hidden="true"
        class="absolute top-1/2 right-0 -translate-y-1/2 text-muted-foreground opacity-0 transition-[opacity,transform,color] duration-300 ease-in-out group-hover/link:translate-x-0 group-hover/link:text-primary group-hover/link:opacity-100"
      />
    </a>
  ) : (
    <div class="min-w-0 flex-1 pl-0">
      <span class="text-sm font-semibold tracking-tight text-foreground sm:text-base">
        {title}
      </span>

      {description && (
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground line-clamp-2">
          {description}
        </p>
      )}
    </div>
  )}
</article>
