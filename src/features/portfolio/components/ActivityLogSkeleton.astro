---
import SectionHeading from "@components/SectionHeading.astro";
---

<section
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
  aria-hidden="true"
>
  <SectionHeading label="github.log" />
  <div class="border-l border-border ml-2 sm:ml-3 pl-5 sm:pl-8 space-y-8">
    {
      Array.from({ length: 3 }).map(() => (
        <div class="space-y-3 pt-1.5">
          <span class="block w-40 h-3 bg-secondary rounded animate-pulse" />
          <ul class="space-y-2">
            {Array.from({ length: 2 }).map(() => (
              <li class="flex items-center gap-x-4 gap-y-1">
                <span class="shrink-0 w-14 h-3 bg-secondary rounded animate-pulse" />
                <span class="block w-48 h-3 bg-secondary rounded animate-pulse" />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
