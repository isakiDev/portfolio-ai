---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import SectionHeading from "@/components/SectionHeading.astro";
import ProjectListItem from "@/features/projects/components/ProjectListItem.astro";

export async function getPublishedEntries<T extends "blog" | "projects">(
  collection: T,
): Promise<CollectionEntry<T>[]> {
  const entries = await getCollection(collection);
  return entries
    .filter((entry) => !entry.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
}

const projects = await getPublishedEntries("projects");
const recentProjects = projects.slice(0, 4);
---

<section
  class="mx-auto mb-16 max-w-5xl px-4 sm:px-8 md:px-16 lg:mb-32"
  id="projects"
>
  <SectionHeading label="proyectos.md" />

  <div>
    {recentProjects.map((project) => (
      <ProjectListItem entry={project} />
    ))}
  </div>
</section>
