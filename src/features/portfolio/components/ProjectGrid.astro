---
import { projects } from "../data/projects";
import SectionHeading from "@components/SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
---

<section
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
  id="projects"
>
  <SectionHeading label="proyectos.md" />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          image={project.image}
          imageAlt={`${project.title} Preview`}
          tech={project.tech}
          url={project.url}
          repoUrl={project.repoUrl}
        />
      ))
    }
  </div>

  <!-- <div class="w-full py-2 mt-4 flex justify-center items-center">
    <a
      href="https://github.com/isakiDev?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Ver proyectos creados"
      title="Ver proyectos"
