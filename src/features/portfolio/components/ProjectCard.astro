---
import Badge from "./Badge.astro";
import ExternalLink from "@components/icons/ExternalLink.astro";
import GitHubIcon from "@components/icons/GitHub.astro";

export interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  statusLabel: string;
  statusVariant: "primary" | "accent" | "secondary";
  tech: string[];
  url?: string;
  repoUrl?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  statusLabel,
  statusVariant,
  tech,
  url,
  repoUrl,
} = Astro.props;
---

<article
  class="group flex flex-col rounded-lg border border-border/60 bg-card p-6 transition-colors hover:border-primary/40 sm:p-8"
>
  <figure
    class="mb-5 overflow-hidden rounded-lg border border-border/60 bg-background sm:mb-6"
  >
    {
      url ? (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Ver proyecto ${title}`}
        >
          <img
            src={image}
            alt={imageAlt}
            loading="lazy"
            decoding="async"
            class="aspect-video h-full w-full object-cover"
          />
        </a>
      ) : (
        <img
          src={image}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="aspect-video h-full w-full object-cover"
        />
      )
    }
  </figure>

  <header class="mb-4 flex items-start justify-between gap-4 sm:mb-5">
    <div class="min-w-0 flex-1">
      <h3
        class="text-lg font-semibold tracking-tight text-foreground mb-3"
      >
        {title}
      </h3>

      <div class="flex flex-wrap gap-2">
        <Badge variant={statusVariant}>{statusLabel}</Badge>

        {tech.map((technology) => (
          <Badge variant="secondary">{technology}</Badge>
        ))}
      </div>
    </div>

    {(repoUrl || url) && (
      <nav
        class="flex shrink-0 gap-1.5"
        aria-label={`Project links for ${title}`}
      >
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver código fuente"
            title="Ver código fuente"
            class="flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            <GitHubIcon />
          </a>
        )}

        {url && (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver proyecto en vivo"
            title="Ver proyecto en vivo"
            class="flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            <ExternalLink class="size-4" />
          </a>
        )}
      </nav>
    )}
  </header>

  <p class="text-sm leading-relaxed text-muted-foreground">{description}</p>
</article>