---
import { Download } from "@lucide/astro";
import LinkButton from "@/components/ui/LinkButton.astro";
import { site } from "@/config/site";
---

<LinkButton
  href={site.assets.cv}
  external
  title="Descargar CV"
  class="group cursor-pointer font-medium"
>
  Descargar CV
  <Download
    size={16}
    class="transition-transform duration-200 group-hover:translate-y-0.5"
  />
</LinkButton>
