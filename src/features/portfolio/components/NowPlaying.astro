---
import {
  SPOTIFY_CLIENT_ID,
  SPOTIFY_CLIENT_SECRET,
  SPOTIFY_REFRESH_TOKEN,
} from "astro:env/server";

import { CirclePause, EarbudsOff } from "@lucide/astro";

import SoundBar from "@components/icons/Soundbar.astro";
import Vinyl from "@features/portfolio/components/Vinyl.astro";

import { nowPlayingAdapter } from "@features/portfolio/adapters/now-playing.adapter";
import { getNowPlaying } from "@features/portfolio/services/now-playing.service";

const fallbackTrack = {
  albumImageUrl:
    "https://res.cloudinary.com/dzn3nempv/image/upload/v1760909384/portfolio/albumCover_bractr.png",
  title: "Usuario",
  artist: "desconectado",
  isPlaying: undefined,
};

const nowPlaying = await getNowPlaying({
  clientId: SPOTIFY_CLIENT_ID,
  clientSecret: SPOTIFY_CLIENT_SECRET,
  refreshToken: SPOTIFY_REFRESH_TOKEN,
});

const track = nowPlaying ? nowPlayingAdapter(nowPlaying) : fallbackTrack;

const { albumImageUrl, title, artist, isPlaying } = track;

const PlayerIcon =
  isPlaying === undefined ? EarbudsOff : isPlaying ? SoundBar : CirclePause;
---

<article
  class:list={[
    "group flex w-fit items-center gap-3 rounded-xl outline bg-card px-2 py-1",
    {
      "outline-primary/40 bg-primary/5 shadow-lg shadow-primary/20": isPlaying,
    },
    { "outline-border hover:outline-primary/30": !isPlaying },
  ]}
  aria-label="Reproducción actual"
>
  <Vinyl imageUrl={albumImageUrl} isPlaying={!!isPlaying} />

  <div class="flex flex-col justify-center text-xs">
    <p
      class="max-w-28 truncate font-semibold leading-tight text-foreground"
      title={title}
    >
      {title}
    </p>

    <p
      class="max-w-28 truncate leading-tight text-muted-foreground"
      title={artist}
    >
      {artist}
    </p>
  </div>

  <PlayerIcon
    size={20}
    class="ml-auto text-muted-foreground"
    aria-hidden="true"
  />
</article>
