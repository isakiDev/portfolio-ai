---
import ChevronRight from "@/components/icons/ChevronRight.astro";
import { projects } from "../data/projects.data";
import SectionHeading from "@components/SectionHeading.astro";
import ProjectCard from "@features/portfolio/components/ProjectCard.astro";
---

<section
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
  id="projects"
>
  <SectionHeading label="proyectos.md" />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          imageUrl={project.imageUrl}
          imageAlt={`${project.title} Preview`}
          tech={project.tech}
          deployUrl={project.deployUrl}
          repoUrl={project.repoUrl}
        />
      ))
    }
  </div>

  <a
    target="_blank"
    rel="noopener noreferrer"
    href="https://github.com/isakiDev?tab=repositories"
    class="flex items-center gap-1.5 text-xs tracking-wider text-primary hover:text-primary/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group mt-8 w-fit mx-auto"
  >
    VER MÁS PROYECTOS
    <ChevronRight class="size-3.5 group-hover:translate-x-1 duration-150" />
  </a>
</section>
