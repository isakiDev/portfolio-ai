---
import ChevronRight from "@components/icons/ChevronRight.astro";
---

<section class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32">
  <div
    class="relative overflow-hidden rounded-lg border border-border/60 bg-card p-6 sm:p-8"
  >
    <div class="absolute top-0 left-0 h-0.5 w-full bg-primary"></div>

    <h3 class="flex items-center gap-2.5 font-mono text-sm text-foreground mb-6">
      <ChevronRight class="size-4 text-primary" />
      Portfolio_Assistant.sh
    </h3>

    <div class="flex flex-col md:flex-row gap-4 sm:gap-5">
      <input
        aria-label="Preguntar al asistente"
        class="grow rounded-md bg-transparent border-b border-input py-2 font-mono text-sm text-foreground placeholder:text-muted-foreground transition-colors focus:border-primary focus-visible:outline-none"
        placeholder="Pregunta sobre stack, experiencia o disponibilidad..."
        type="text"
      />

      <button
        class="w-full sm:w-auto rounded-md border border-primary px-5 py-2 text-xs font-medium tracking-wider text-primary transition-colors hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card"
      >
        QUERY
      </button>
    </div>

    <p class="mt-4 text-xs tracking-wider text-muted-foreground">
      Prueba: "¿Cuál es la experiencia de Gaspar con Docker?"
    </p>
  </div>
</section>