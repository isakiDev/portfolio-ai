---
import SectionHeading from "@components/SectionHeading.astro";
import GitHubIcon from "@components/icons/GitHub.astro";

import { getLatestCommits } from "../services/github.service";

const repositories = await getLatestCommits();

function formatCommitDate(dateStr: string): string {
  const d = new Date(dateStr);
  const months = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ];
  return `${months[d.getUTCMonth()]} ${String(d.getUTCDate()).padStart(2, "0")}`;
}

function shortHash(url: string): string {
  const parts = url.split("/");
  return parts[parts.length - 1]?.slice(0, 7) ?? "";
}
---

<section
  id="activity"
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
>
  <SectionHeading label="github.log" />

  <div
    class="border-l border-border ml-2 sm:ml-3 pl-5 sm:pl-8 font-mono text-[11px] sm:text-xs space-y-8"
  >
    {
      repositories.map(({ repo, commits }) => (
        <article class="space-y-3 pt-1.5">
          <a
            href={`https://github.com/isakidev/${repo}`}
            target="_blank"
            rel="noopener noreferrer"
            class="relative inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            <div class="absolute bg-background p-0.5 left-[-28.5px] sm:-left-10.25 top-1/2 -translate-y-1/2">
              <GitHubIcon class={"size-3"} />
            </div>

            <span class="font-semibold text-primary">{repo}</span>
          </a>

          <ul class="space-y-1">
            {commits.map((commit) => (
              <li>
                <a
                  href={commit.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex flex-col sm:flex-row sm:items-center gap-x-4 gap-y-1 rounded-md px-2 py-1.5 transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                >
                  <time
                    datetime={commit.date}
                    class="shrink-0 text-muted-foreground"
                  >
                    {formatCommitDate(commit.date)}
                  </time>

                  <div class="flex gap-1.5 min-w-0">
                    <span class="shrink-0 text-accent">
                      [{shortHash(commit.url)}]
                    </span>
                    <span class="truncate text-foreground">
                      {commit.message}
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
