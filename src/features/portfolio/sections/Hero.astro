---
import OpenCode from "@components/icons/OpenCode.astro";
import Linux from "@components/icons/Linux.astro";
import GitHub from "@components/icons/GitHub.astro";
import DownloadCV from "../components/DownloadCV.astro";

const PORTRAIT_ALT = "Gaspar Castillo Catrifol";
const PORTRAIT_SIZE = { width: 1024, height: 1024 };

const portrait = {
  light:
    "https://res.cloudinary.com/dzn3nempv/image/upload/v1795182896/portfolio/logo-with-glasses_vddas8.png",
  dark: "https://res.cloudinary.com/dzn3nempv/image/upload/v1787864719/portfolio/me-dark_st06ti.png",
};
---

<section
  id="hero"
  class="relative isolate flex flex-col-reverse items-center gap-12
    py-12 sm:py-16 md:flex-row md:justify-between md:gap-8 lg:py-24"
>
  <!-- Content -->
  <div
    class="flex max-w-2xl flex-col items-center text-center
    md:items-start md:text-left"
  >
    <span
      class="mb-6 inline-flex items-center gap-2 rounded-full
      border border-border bg-card px-3 py-1.5 text-xs font-medium
      text-muted-foreground"
    >
      <span class="size-2 rounded-full bg-primary animate-pulse"></span>
      Desarrollador de Software
    </span>

    <h1
      class="mb-5 text-4xl font-bold tracking-tight text-foreground
      sm:text-5xl lg:text-7xl lg:leading-[1.05]"
    >
      Gaspar Castillo
      <span class="block text-primary">Catrifol</span>
    </h1>

    <div class="mb-8">
      <p class="text-base font-semibold leading-relaxed text-foreground sm:text-lg">
        Disfruto resolviendo problemas complejos con soluciones simples.
      </p>

      <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
        Me enfoco en construir software claro, mantenible y preparado para
        evolucionar.
      </p>
    </div>

    <DownloadCV />
  </div>

  <!-- Portrait -->
  <div class="relative shrink-0">
    <div
      class="relative rounded-full border border-border/70 bg-card
      p-2 shadow-xl shadow-primary/5"
    >
      <img
        src={portrait.dark}
        alt={PORTRAIT_ALT}
        width={PORTRAIT_SIZE.width}
        height={PORTRAIT_SIZE.height}
        decoding="async"
        class="hidden size-44 rounded-full object-cover
        dark:block sm:size-48 lg:size-56"
      />

      <img
        src={portrait.light}
        alt={PORTRAIT_ALT}
        width={PORTRAIT_SIZE.width}
        height={PORTRAIT_SIZE.height}
        decoding="async"
        class="block size-44 rounded-full object-cover
        dark:hidden sm:size-48 lg:size-56"
      />
    </div>

    <!-- OpenCode -->
    <span
      class="floating-icon floating-opencode absolute -right-3 top-4
      rounded-2xl border border-border bg-card p-2.5 shadow-lg"
      role="img"
      aria-label="OpenCode"
      title="OpenCode"
    >
      <OpenCode class="size-6" aria-hidden="true" />
    </span>

    <!-- Linux -->
    <span
      class="floating-icon floating-linux absolute -bottom-3 -left-3
      rounded-2xl border border-border bg-card p-2.5 shadow-lg"
      role="img"
      aria-label="Linux"
      title="Linux"
    >
      <Linux class="size-6" aria-hidden="true" />
    </span>

    <!-- GitHub -->
    <span
      class="floating-icon floating-github absolute bottom-5 -right-4
      rounded-2xl border border-border bg-card p-2.5 shadow-lg"
      role="img"
      aria-label="GitHub"
      title="GitHub"
    >
      <GitHub class="size-6" aria-hidden="true" />
    </span>
  </div>
</section>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-8px);
    }
  }

  .floating-icon {
    animation: float 3s ease-in-out infinite;
    will-change: transform;
  }

  .floating-opencode {
    animation-delay: 0s;
  }

  .floating-linux {
    animation-delay: 1s;
    animation-duration: 3.5s;
  }

  .floating-github {
    animation-delay: 0.5s;
    animation-duration: 4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-icon {
      animation: none;
      will-change: auto;
    }
  }
</style>
