---
import SectionHeading from "@components/SectionHeading.astro";
import TimelineItem from "@features/portfolio/components/TimelineItem.astro";

import { experience } from "../data/experience.data";
---

<section
  class="max-w-5xl mx-auto px-4 sm:px-8 md:px-16 mb-16 lg:mb-32"
  id="experience"
>
  <SectionHeading label="experiencia.md" />

  <div class="space-y-10 lg:space-y-12 ml-2 sm:ml-3 border-l border-border">
    {
      experience.map((entry) => (
        <TimelineItem
          period={entry.period}
          title={entry.company}
          subtitle={entry.role}
          dotColor={entry.dotColor}
        >
          <div class="rounded-lg border border-border/60 bg-card p-4 sm:p-6">
            <p class="text-muted-foreground text-sm sm:text-base mb-4">
              {entry.description}
            </p>

            <ul class="space-y-2 sm:space-y-3">
              {entry?.highlights?.map((highlight) => (
                <li class="flex gap-2 sm:gap-3 text-sm">
                  <span
                    class="text-primary font-mono shrink-0 leading-relaxed"
                    aria-hidden="true"
                  >
                    ›
                  </span>
                  <span class="text-muted-foreground leading-relaxed">
                    {highlight}
                  </span>
                </li>
              ))}
            </ul>

            {entry.metrics && (
              <div class="mt-4 sm:mt-6 pt-4 sm:pt-6 border-t border-border/60 flex flex-col sm:flex-row gap-4 sm:gap-8">
                {entry.metrics.map((metric) => (
                  <div>
                    <span class="block font-mono text-[10px] text-muted-foreground tracking-wider uppercase">
                      {metric.label}
                    </span>

                    <span class="text-primary font-mono text-xs tracking-wider leading-none font-medium">
                      {metric.value}
                    </span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </TimelineItem>
      ))
    }
  </div>
</section>
