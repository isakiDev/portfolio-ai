---
import { getCollection } from "astro:content";

import SectionHeading from "@components/SectionHeading.astro";
import ChevronRight from "@components/icons/ChevronRight.astro";
import { formatDate } from "@/utils/format-date";
import { getReadingTime } from "@/utils/reading-time";
import Badge from "@/components/Badge.astro";

const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
blogPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const [featuredPost, ...restPosts] = blogPosts;
const recentPosts = restPosts.slice(0, 2);
---

{featuredPost && (
  <section id="blog">
    <SectionHeading label="Blog" />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <a
          href={`/blog/${featuredPost.id}`}
          class="group relative block h-full rounded-lg border border-border/60 bg-card p-5 transition-colors hover:border-primary/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:p-7"
        >
          {featuredPost.data.tags?.[0] && (
            <Badge class="mb-2" variant="accent">
              {featuredPost.data.tags[0]}
            </Badge>
          )}

          <h3 class="mb-3 text-xl leading-tight tracking-[-0.02em] text-foreground transition-colors group-hover:text-primary sm:mb-4 sm:text-2xl lg:text-[1.875rem]">
            {featuredPost.data.title}
          </h3>

          <p class="mb-6 line-clamp-2 text-sm text-muted-foreground sm:text-base">
            {featuredPost.data.description}
          </p>

          <div class="flex items-center gap-3 border-t border-border/60 pt-4 font-mono text-xs tracking-wider text-muted-foreground">
            <span>{getReadingTime(featuredPost.body!)}</span>
            <span class="opacity-50" aria-hidden="true">
              •
            </span>
            <span>{formatDate(featuredPost.data.date)}</span>
          </div>
        </a>
      </div>

      <div class="flex flex-col gap-4 sm:gap-5 lg:col-span-5">
        {recentPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group rounded-lg border border-border/60 bg-card p-5 transition-colors hover:border-primary/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            <div class="flex items-center justify-between gap-4">
              {post.data.tags?.[0] ? (
                <Badge variant="accent">{post.data.tags[0]}</Badge>
              ) : (
                <span />
              )}
              <time class="shrink-0 font-mono text-[11px] text-muted-foreground">
                {formatDate(post.data.date)}
              </time>
            </div>
            <h3 class="mt-2 mb-1.5 text-lg font-medium leading-snug text-foreground transition-colors group-hover:text-primary">
              {post.data.title}
            </h3>
            <div class="font-mono text-[11px] text-muted-foreground">
              {getReadingTime(post.body!)}
            </div>
          </a>
        ))}

        <a
          href="/blog"
          class="group mx-auto mt-auto flex w-fit items-center gap-1.5 pt-4 text-xs tracking-wider text-primary transition-colors hover:text-primary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          VER TODAS LAS NOTAS
          <ChevronRight class="size-3.5 transition-transform duration-150 group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </section>
)}
