---
import Clock from "@components/icons/Clock.astro";

interface Props {
  href: string;
  title: string;
  date: string;
  description: string;
  readingTime: string;
}

const { href, title, date, description, readingTime } = Astro.props;
---

<article
  class="group relative flex h-full flex-col gap-3 rounded-lg border border-border/60 bg-card p-5 sm:p-6 transition-colors hover:border-primary/40 focus-within:ring-2 focus-within:ring-ring"
>
  <a
    class="absolute inset-0 z-10 rounded-lg"
    href={href}
    aria-label={title}
  >
  </a>

  <header class="flex items-start justify-between gap-4">
    <div class="flex flex-col gap-2">
      <h3
        class="text-lg font-semibold leading-snug tracking-tight text-foreground line-clamp-2"
      >
        {title}
      </h3>

      <div class="flex items-center gap-1.5 text-muted-foreground">
        <Clock class="size-3.5" />
        <span class="text-xs">{readingTime}</span>
      </div>
    </div>

    <time
      class="shrink-0 text-xs whitespace-nowrap text-muted-foreground"
      >{date}</time
    >
  </header>

  <p class="text-sm leading-relaxed text-muted-foreground line-clamp-2">
    {description}
  </p>
</article>