---
import type { CollectionEntry } from "astro:content";

import { ArrowRight, Calendar, Clock } from "@lucide/astro";

import Badge from "@/components/Badge.astro";

import { formatDate } from "@/utils/format-date";
import { getReadingTime } from "@/utils/reading-time";

interface Props {
  entry: CollectionEntry<"blog">;
  class?: string;
  showMeta?: boolean;
}

const { entry, class: className, showMeta = true } = Astro.props;

const { title, description, date, tags } = entry.data;

const href = `/blog/${entry.id}/`;
const readingTime = getReadingTime(entry.body!);
const hasTags = tags && tags.length > 0;
---

<article
  class:list={[
    "relative border-b border-border last:border-b-0",
    showMeta
      ? "py-5"
      : [
          "border-l-2 border-l-transparent",
          "transition-[padding-left,border-color,background-color] duration-200 ease-in-out",
          "hover:border-l-primary hover:bg-surface/30 hover:pl-2",
        ],
    className,
  ]}
>
  {showMeta ? (
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
        <div class="flex items-center gap-1.5">
          <Calendar size={14} aria-hidden="true" />
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </div>

        <span aria-hidden="true">·</span>

        <div class="flex items-center gap-1.5">
          <Clock size={14} aria-hidden="true" />
          <span>{readingTime}</span>
        </div>
      </div>

      <h3 class="mt-2 text-base font-semibold tracking-tight text-foreground sm:text-lg">
        <a
          href={href}
          class="no-underline transition-colors duration-200 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {title}
        </a>
      </h3>

      <p class="mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2">
        {description}
      </p>

      {hasTags && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <Badge variant="accent">{tag}</Badge>
          ))}
        </div>
      )}
    </div>
  ) : (
    <a
      href={href}
      class="group/link block min-w-0 py-3 pr-8 no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      aria-label={`Leer ${title}`}
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime}</span>
      </div>

      <h3 class="mt-1 text-sm font-semibold tracking-tight text-foreground transition-colors duration-200 group-hover/link:text-primary sm:text-base">
        {title}
      </h3>

      <p class="mt-1 text-sm leading-relaxed text-muted-foreground line-clamp-2">
        {description}
      </p>

      <ArrowRight
        size={18}
        aria-hidden="true"
        class="absolute top-1/2 right-0 -translate-y-1/2 text-muted-foreground opacity-0 transition-[opacity,transform,color] duration-300 ease-in-out group-hover/link:translate-x-0 group-hover/link:text-primary group-hover/link:opacity-100"
      />
    </a>
  )}
</article>
