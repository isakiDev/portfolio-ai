---
import Badge from "@/components/Badge.astro";

interface Props {
  href: string;
  title: string;
  date: string;
  description: string;
  readingTime: string;
  tag?: string;
}

const { href, title, date, description, readingTime, tag } = Astro.props;
---

<article class="group relative rounded-lg border border-border/60 bg-card p-5 transition-colors hover:border-primary/40 focus-within:ring-2 focus-within:ring-ring">
  <a href={href} class="absolute inset-0 rounded-lg" aria-label={title}></a>

  <div class="flex items-center justify-between gap-4">
    {tag ? <Badge variant="accent">{tag}</Badge> : <span />}
    <time class="shrink-0 font-mono text-[11px] text-muted-foreground">{date}</time>
  </div>

  <h3 class="mt-2 mb-1.5 text-lg font-medium leading-snug text-foreground transition-colors group-hover:text-primary">
    {title}
  </h3>

  <p class="mb-3 text-sm leading-relaxed text-muted-foreground line-clamp-2">
    {description}
  </p>

  <div class="font-mono text-[11px] text-muted-foreground">
    {readingTime}
  </div>
</article>
