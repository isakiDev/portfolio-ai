---
import type { CollectionEntry } from "astro:content";

import PostCard from "./PostCard.astro";

interface Props {
  items: CollectionEntry<"blog">[];
  class?: string;
  showMeta?: boolean;
}

const { items, class: className, showMeta = true } = Astro.props;
---

<div class:list={["flex flex-col", className]}>
  {items.map((entry) => (
    <PostCard entry={entry} showMeta={showMeta} />
  ))}
</div>
